{
  "name": "AITER MI100 (Coder / Envbuilder)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "containerUser": "root",
  "remoteUser": "root",
  "containerEnv": {
    "CODEX_HOME": "/workspaces/.codex",
    "GPU_ARCHS": "gfx908",
    "PYTORCH_ROCM_ARCH": "gfx908",
    "AITER_USE_SYSTEM_TRITON": "1",
    "PREBUILD_KERNELS": "0",
    "MAX_JOBS": "8"
  },
  "postCreateCommand": [
    "bash",
    ".devcontainer/bootstrap.sh"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/aiter-venv/bin/python",
        "C_Cpp.default.compilerPath": "/opt/rocm/llvm/bin/clang++"
      }
    }
  }
}
